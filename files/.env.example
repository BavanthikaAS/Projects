# Database Configuration (PostgreSQL / Supabase connection URL or SQLite for local dev)
DATABASE_URL=sqlite:///./auctionhub.db

# JWT & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Storage / Project (Optional for local mockup or live Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# AI Service Configuration
AI_PROVIDER=gemini
AI_API_KEY=your_api_key_here
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_SECONDS=8

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1:5500
